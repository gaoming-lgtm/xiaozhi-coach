        "color": "#111827",
        "size": [
          27,
          27,
          4
        ],
        "detail": "黑色小板 + 4 针 VCC GND SCL SDA"
      },
      "note": "白光，4 针 IIC"
    },
    {
      "id": "breadboard",
      "name": "830 孔面包板",
      "qty": 1,
      "visual": {
        "kind": "breadboard",
        "color": "#f5f5f0",
        "size": [
          165,
          55,
          10
        ],
        "detail": "中间凹槽 + 上下电源轨 + 红蓝线"
      },
