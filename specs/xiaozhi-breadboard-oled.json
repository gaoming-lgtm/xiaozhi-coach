    },
    {
      "id": "wires",
      "name": "杜邦线 120 根",
      "qty": 120,
      "visual": {
        "kind": "wire",
        "color": "#888888",
        "detail": "母母 / 公公 / 公母，21cm"
      },
      "note": "配色规范：红/棕=VCC，灰/黑=GND，橙/咖啡=信号"
    },
    {
      "id": "multimeter",
      "name": "DT830B 万用表",
      "qty": 1,
      "visual": {
        "kind": "tool",
        "detail": "黑色方表 + 红黑表笔"
      },
      "note": "第二步就要用：蜂鸣档测短路"
    }
  ],
  "wiring": [
    {
      "id": "w-mic-vdd",
      "signal": "INMP441 VDD",
      "from": [
        "esp32s3",
        "3V3"
      ],
      "to": [
        "inmp441",
        "VDD"
      ],
      "color": "红",
      "note": "只能 3.3V"
    },
    {
      "id": "w-mic-gnd",
      "signal": "INMP441 GND",
      "from": [
        "esp32s3",
        "GND"
      ],
      "to": [
        "inmp441",
        "GND"
      ],
      "color": "黑",
      "note": ""
    },
    {
      "id": "w-mic-lr",
      "signal": "INMP441 L/R",
      "from": [
        "esp32s3",
        "GND"
      ],
      "to": [
        "inmp441",
        "L/R"
      ],
      "color": "黑",
      "note": "接地 = 左声道"
    },
    {
      "id": "w-mic-ws",
      "signal": "INMP441 WS",
      "from": [
        "esp32s3",
        "GPIO4"
      ],
      "to": [
        "inmp441",
        "WS"
      ],
      "color": "橙",
      "note": "字选择"
    },
    {
      "id": "w-mic-sck",
      "signal": "INMP441 SCK",
      "from": [
        "esp32s3",
        "GPIO5"
      ],
      "to": [
        "inmp441",
        "SCK"
      ],
      "color": "黄",
      "note": "位时钟"
    },
    {
      "id": "w-mic-sd",
      "signal": "INMP441 SD",
      "from": [
        "esp32s3",
        "GPIO6"
      ],
      "to": [
        "inmp441",
        "SD"
      ],
      "color": "蓝",
      "note": "数据输出"
    },
    {
      "id": "w-amp-vin",
      "signal": "MAX98357A VIN",
      "from": [
        "esp32s3",
        "3V3"
      ],
      "to": [
        "max98357",
        "VIN"
      ],
      "color": "红",
      "note": "官方默认 3.3V；接 5V 需先短接背面 IN-OUT"
    },
    {
      "id": "w-amp-gnd",
      "signal": "MAX98357A GND",
      "from": [
        "esp32s3",
        "GND"
      ],
      "to": [
        "max98357",
        "GND"
      ],
      "color": "黑",
      "note": ""
    },
    {
      "id": "w-amp-sd",
      "signal": "MAX98357A SD",
      "from": [
        "esp32s3",
        "3V3"
      ],
      "to": [
        "max98357",
        "SD"
      ],
      "color": "红",
      "note": "拉高 = 常开，不关机"
    },
    {
      "id": "w-amp-gain",
      "signal": "MAX98357A GAIN",
      "from": [
        "esp32s3",
        "GND"
      ],
      "to": [
        "max98357",
        "GAIN"
      ],
      "color": "黑",
      "note": "接地 = 低增益"
    },
    {
      "id": "w-amp-din",
      "signal": "MAX98357A DIN",
      "from": [
        "esp32s3",
        "GPIO7"
      ],
      "to": [
        "max98357",
        "DIN"
      ],
      "color": "橙",
      "note": "数字信号"
    },
    {
      "id": "w-amp-bclk",
      "signal": "MAX98357A BCLK",
      "from": [
        "esp32s3",
        "GPIO15"
      ],
      "to": [
        "max98357",
        "BCLK"
      ],
      "color": "黄",
      "note": "位时钟"
    },
    {
      "id": "w-amp-lrc",
      "signal": "MAX98357A LRC",
      "from": [
        "esp32s3",
        "GPIO16"
      ],
      "to": [
        "max98357",
        "LRC"
      ],
      "color": "蓝",
      "note": "左右时钟"
    },
    {
      "id": "w-spk",
      "signal": "喇叭",
      "from": [
        "max98357",
        "音频+"
      ],
      "to": [
        "speaker",
        "+"
      ],
      "color": "红",
      "note": "红线接 +，插 2P 端子"
    },
    {
      "id": "w-oled-vcc",
      "signal": "OLED VCC",
      "from": [
        "esp32s3",
        "3V3"
      ],
      "to": [
        "oled",
        "VCC"
      ],
      "color": "红",
      "note": "只能 3.3V"
    },
    {
      "id": "w-oled-gnd",
      "signal": "OLED GND",
      "from": [
        "esp32s3",
        "GND"
      ],
      "to": [
        "oled",
        "GND"
      ],
      "color": "黑",
      "note": ""
    },
    {
      "id": "w-oled-sda",
      "signal": "OLED SDA",
      "from": [
        "esp32s3",
        "GPIO41"
      ],
      "to": [
        "oled",
        "SDA"
      ],
      "color": "绿",
      "note": "板上丝印可能写 SDA"
    },
    {
      "id": "w-oled-scl",
      "signal": "OLED SCL",
      "from": [
        "esp32s3",
        "GPIO42"
      ],
      "to": [
        "oled",
        "SCL"
      ],
      "color": "黄",
      "note": "板上丝印可能写 SCK/SCL"
    }
  ],
  "steps": [
    {
      "id": "s01",
      "title": "清点零件",
      "goal": "把 8 样零件摊开，确认齐了（镊子和螺丝刀是辅助工具，不算）",
      "why": "少一件，后面每一步都会卡在互相猜",
      "parts": [
        "esp32s3",
        "inmp441",
        "max98357",
        "speaker",
        "oled",
        "breadboard",
        "wires",
        "multimeter"
      ],
      "do": [
        "全部倒在桌上摊平",
        "对照清单数一遍"
      ],
      "check": "照片里 8 样零件齐全，每样都完整露出来",
      "safety": "info"
    },
    {
      "id": "s02",
      "title": "认识板子（拔掉 USB）",
      "goal": "找到 3V3、GND、GPIO4、5、6、7、15、16、41、42 在哪",
      "why": "这块板有 36 个 IO，认错一个脚后面全错",
      "parts": [
        "esp32s3"
      ],
      "do": [
        "把板子平放，两个 Type-C 朝向自己",
        "对着丝印找 3V3 和 GND 的位置",
        "找到 GPIO4~7 这一组"
      ],
      "check": "照片能看清丝印，并指着 3V3 的位置",
      "pitfalls": [
        "左边的 Type-C 是直通 USB，右边才是串口，刷固件用右边"
      ],
      "safety": "info"
    },
    {
      "id": "s03",
      "title": "上电前测短路",
      "goal": "确认 3V3 和 GND 之间没有短路",
      "why": "官方文档作者就是因为面包板电源轨短路，烧坏过两块板子的 USB 口",
      "parts": [
        "multimeter",
        "breadboard"
      ],
      "do": [
        "万用表转到蜂鸣档（二极管档）",
        "一根表笔点面包板 3V3 轨，另一根点 GND 轨",
        "不响 = 正常；响 = 立刻停下"
      ],
      "check": "拍万用表读数 / 或者拍你测的位置，并且说一声响没响",
      "pitfalls": [
        "别用电阻档，就用蜂鸣档"
      ],
      "safety": "danger"
    },
    {
      "id": "s04",
      "title": "铺面包板电源轨",
      "goal": "把 3V3 和 GND 引到面包板上下两条轨",
      "why": "面包板的红蓝电源轨默认不通电，不接就是全板没电——十个人九个卡这",
      "parts": [
        "breadboard",
        "wires",
        "esp32s3"
      ],
      "do": [
        "红线：板子 3V3 → 面包板上排 + 轨",
        "黑线：板子 GND → 面包板上排 − 轨",
        "再引一根到下排"
      ],
      "check": "照片里能看出上排 + 是红线、− 是黑线，两根都从板子出发",
      "pitfalls": [
        "上排和下排是分开的两条轨，要各引一次"
      ],
      "safety": "info"
    },
    {
      "id": "s05",
      "title": "插上 ESP32-S3",
      "goal": "把板子跨在面包板凹槽上插好",
      "why": "板子必须跨槽，两排脚不能插在同一行",
      "parts": [
        "esp32s3",
        "breadboard"
      ],
      "do": [
        "板子骑在中间凹槽上",
        "两排排针分别插进左右两侧",
        "轻轻压到底"
      ],
      "check": "照片里板子横跨凹槽，两排脚各在一边",
      "pitfalls": [
        "不能斜插，不能只插一半"
      ],
      "safety": "info"
    },
    {
      "id": "s06",
      "title": "接麦克风电源",
      "goal": "INMP441 的 VDD、GND、L/R 接好",
      "why": "L/R 接地才出左声道，浮空会没声音",
      "parts": [
        "inmp441",
        "wires"
      ],
      "wiring": [
        "w-mic-vdd",
        "w-mic-gnd",
        "w-mic-lr"
      ],
      "do": [
        "VDD → 3V3（红）",
        "GND → GND（黑）",
        "L/R → GND（黑，和 GND 同一根短接）"
      ],
      "check": "照片能看清模块上三根线的位置和颜色",
      "pitfalls": [
        "VDD 千万不能接 5V，会烧咪头"
      ],
      "safety": "danger"
    },
    {
      "id": "s07",
      "title": "接麦克风信号线",
      "goal": "WS、SCK、SD 三根线接到 GPIO4/5/6",
      "why": "这三根是 I2S 的声音数据，接反就是没声音或者全是噪音",
      "parts": [
        "inmp441",
        "wires"
      ],
      "wiring": [
        "w-mic-ws",
        "w-mic-sck",
        "w-mic-sd"
      ],
      "do": [
        "WS → GPIO4",
        "SCK → GPIO5",
        "SD → GPIO6"
      ],
      "check": "照片能看清每根线落到板子哪个脚",
      "pitfalls": [
        "WS 和 SCK 接反是最常见的错误，现象是只有电流声"
      ],
      "safety": "warn"
    },
    {
      "id": "s08",
      "title": "接功放电源",
      "goal": "MAX98357A 的 VIN、GND、SD、GAIN 接好",
      "why": "SD 拉高才不关机，GAIN 接地是低增益",
      "parts": [
        "max98357",
        "wires"
      ],
      "wiring": [
        "w-amp-vin",
        "w-amp-gnd",
        "w-amp-sd",
        "w-amp-gain"
      ],
      "do": [
        "VIN → 3V3（红）",
        "GND → GND（黑）",
        "SD → 3V3（红）",
        "GAIN → GND（黑）"
      ],
      "check": "照片能看清四根线，尤其 SD 和 GAIN 没有接反",
      "pitfalls": [
        "VIN 接 3.3V 就够了；想更响再考虑短接背面 IN-OUT 用 5V"
      ],
      "safety": "warn"
    },
    {
      "id": "s09",
      "title": "接功放信号线",
      "goal": "DIN、BCLK、LRC 接到 GPIO7/15/16",
      "why": "这三根是把声音送到喇叭的路",
      "parts": [
        "max98357",
        "wires"
      ],
      "wiring": [
        "w-amp-din",
        "w-amp-bclk",
        "w-amp-lrc"
      ],
      "do": [
        "DIN → GPIO7",
        "BCLK → GPIO15",
        "LRC → GPIO16"
      ],
      "check": "照片能看清三根线的落点",
      "pitfalls": [
        "BCLK 和 LRC 接反 = 只有沙沙声"
      ],
      "safety": "warn"
    },
    {
      "id": "s10",
      "title": "接喇叭",
      "goal": "红线接音频+，黑线接音频−",
      "why": "接反不会烧，但相位反了低音会抵消",
      "parts": [
        "speaker",
        "max98357"
      ],
      "wiring": [
        "w-spk"
      ],
      "do": [
        "喇叭的 2P 插头插进功放模块的音频座",
        "红线对准 +"
      ],
      "check": "照片里插头插到底了",
      "pitfalls": [
        "别把喇叭直接插到板子的 GPIO 上"
      ],
      "safety": "warn"
    },
    {
      "id": "s11",
      "title": "接 OLED",
      "goal": "VCC、GND、SDA、SCL 接到 3V3 / GND / GPIO41 / GPIO42",
      "why": "OLED 用来看配网状态和表情，不是必需品，但接错会拖垮整个 I2C",
      "parts": [
        "oled",
        "wires"
      ],
      "wiring": [
        "w-oled-vcc",
        "w-oled-gnd",
        "w-oled-sda",
        "w-oled-scl"
      ],
      "do": [
        "VCC → 3V3（红）",
        "GND → GND（黑）",
        "SDA → GPIO41",
        "SCL → GPIO42"
      ],
      "check": "照片能看清四根线，VCC 没接到 5V",
      "pitfalls": [
        "SDA 和 SCL 接反 = 屏幕全黑"
      ],
      "safety": "warn"
    },
    {
      "id": "s12",
      "title": "上电前整体复测",
      "goal": "再测一次 3V3 与 GND，确认没短路",
      "why": "接完这么多线，短路概率比空板高得多",
      "parts": [
        "multimeter"
      ],
      "do": [
        "万用表蜂鸣档",
        "测 3V3 轨和 GND 轨",
        "确认不响"
      ],
      "check": "照片拍你测的位置 + 说一声响没响",
      "safety": "danger"
    },
    {
      "id": "s13",
      "title": "插 USB，看灯",
      "goal": "板子上电，PWR 灯亮，RGB 灯亮",
      "why": "这是第一次上电，最危险也最激动的一步",
      "parts": [
        "esp32s3"
      ],
      "do": [
        "数据线插右边那个 Type-C（USB 转串口）",
        "电脑上等几秒",
        "看 PWR 灯和 RGB 灯"
      ],
      "check": "照片里能看到灯亮着",
      "pitfalls": [
        "RGB 不亮但 PWR 亮 → 背面 RGB 焊点没连通",
        "什么灯都不亮 → 拔掉，立刻停下来找我"
      ],
      "safety": "danger"
    },
    {
      "id": "s14",
      "title": "刷固件",
      "goal": "把面包板版固件烧进去",
      "why": "板子是空的，没有固件就什么都不会",
      "parts": [],
      "do": [
        "确认设备管理器里出现 COM 口",
        "用官方网页刷机工具或 esptool 刷 bread-compact-wifi"
      ],
      "check": "截图刷机工具的进度条和最终结果",
      "pitfalls": [
